# Copy to docker/.env (gitignored) to override the local-dev-only placeholder credentials in
# docker-compose.yml. Not required to run the stack - both variables have committed defaults
# that work out of the box; this only matters if even a placeholder shouldn't sit in source
# control on your machine (QA-REVIEW.md Low finding).
POSTGRES_PASSWORD=bidstream
GF_SECURITY_ADMIN_PASSWORD=admin
